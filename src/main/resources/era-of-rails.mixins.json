{
  "required": true,
  "package": "de.nexusrealms.eraofrails.mixin",
  "compatibilityLevel": "JAVA_21",
  "mixins": [
    "AbstractMinecartMixin",
    "DetectorRailMixin",
    "DispenserBlockEntityMixin",
    "ExperimentalMinecartControllerMixin",
    "GameRulesMixin",
    "MinecartDispenserBehaviorMixin",
    "MinecartItemAccessor",
    "RailStateMixin",
    "MinecartSpawnerMixin",
    "MinecartTNTMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  },
  "overwrites": {
    "requireAnnotations": true
  },
  "client": [
    "client.AbstractMinecartEntityRendererMixin",
    "client.ClientLevelMixin",
    "client.MinecartEntityRenderStateMixin"
  ]
}